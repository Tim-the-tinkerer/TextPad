<Window x:Class="TextPad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TextPad.Controls"
        Title="TextPad"
        Icon="Assets/AppIcon.ico"
        Height="720" Width="1100"
        MinHeight="400" MinWidth="600"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">
    <Window.Resources>
        <SolidColorBrush x:Key="TabBarBackgroundBrush" Color="#1A1A1F"/>
        <SolidColorBrush x:Key="TabSelectedBackgroundBrush" Color="#26262B"/>
        <SolidColorBrush x:Key="TabTextBrush" Color="#DBDBDB"/>
        <SolidColorBrush x:Key="TabTextSelectedBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TabAccentBrush" Color="#599EFF"/>
        <SolidColorBrush x:Key="TabHoverBrush" Color="#20FFFFFF"/>
        <SolidColorBrush x:Key="MenuBarBackgroundBrush" Color="#1A1A1F"/>
        <SolidColorBrush x:Key="MenuBarTextBrush" Color="#DBDBDB"/>
        <SolidColorBrush x:Key="MenuPopupBackgroundBrush" Color="#26262B"/>
        <SolidColorBrush x:Key="MenuPopupTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="MenuShortcutTextBrush" Color="#D1D1D1"/>
        <SolidColorBrush x:Key="MenuHighlightBrush" Color="#383D47"/>
        <SolidColorBrush x:Key="MenuDisabledTextBrush" Color="#808080"/>
        <SolidColorBrush x:Key="MenuSeparatorBrush" Color="#40FFFFFF"/>
        <SolidColorBrush x:Key="MenuPopupBorderBrush" Color="#404650"/>

        <Style x:Key="DocumentTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource TabBarBackgroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="{DynamicResource TabBarBackgroundBrush}"
                                    Padding="8,6,8,0">
                                <TabPanel IsItemsHost="True"
                                          Background="Transparent"
                                          HorizontalAlignment="Left"/>
                            </Border>
                            <Border Grid.Row="1"
                                    Background="{DynamicResource TabBarBackgroundBrush}"
                                    BorderThickness="0">
                                <ContentPresenter ContentSource="SelectedContent"
                                                  Margin="0"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DocumentTabItemStyle" TargetType="TabItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TabTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                CornerRadius="6,6,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background"
                                        Value="{DynamicResource TabSelectedBackgroundBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush"
                                        Value="{DynamicResource TabAccentBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TabTextSelectedBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background"
                                        Value="{DynamicResource TabHoverBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource MenuPopupBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MenuPopupBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
        </Style>

        <Style x:Key="EditorContextMenuItemStyle" TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource MenuPopupBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource MenuPopupTextBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Icon" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="EditorContextShortcut"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{TemplateBinding InputGestureText}"
                                           Margin="24,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MenuShortcutTextBrush}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background"
                                        Value="{DynamicResource MenuHighlightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource MenuDisabledTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorContextMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1"
                                Margin="8,4"
                                Background="{DynamicResource MenuSeparatorBrush}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu x:Name="MainMenu"
              DockPanel.Dock="Top"
              Background="{DynamicResource MenuBarBackgroundBrush}"
              Foreground="{DynamicResource MenuBarTextBrush}"
              Padding="4,2">
            <Menu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Background" Value="{DynamicResource MenuPopupBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource MenuPopupTextBrush}"/>
                    <Setter Property="Padding" Value="10,6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Grid>
                                    <Border x:Name="ItemBorder"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter ContentSource="Header"
                                                              RecognizesAccessKey="True"
                                                              VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{TemplateBinding InputGestureText}"
                                                       Margin="24,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MenuShortcutTextBrush}"/>
                                        </Grid>
                                    </Border>
                                    <Popup x:Name="PART_Popup"
                                           Placement="Bottom"
                                           AllowsTransparency="True"
                                           Focusable="False"
                                           IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                           PopupAnimation="{DynamicResource {x:Static SystemParameters.MenuPopupAnimationKey}}">
                                        <Border Background="{DynamicResource MenuPopupBackgroundBrush}"
                                                BorderBrush="{DynamicResource MenuPopupBorderBrush}"
                                                BorderThickness="1"
                                                Padding="2"
                                                SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True"
                                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="Role" Value="TopLevelHeader">
                                        <Setter TargetName="ItemBorder" Property="Background"
                                                Value="{DynamicResource MenuBarBackgroundBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource MenuBarTextBrush}"/>
                                        <Setter Property="Padding" Value="10,4"/>
                                        <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/>
                                    </Trigger>
                                    <Trigger Property="Role" Value="SubmenuHeader">
                                        <Setter TargetName="PART_Popup" Property="Placement" Value="Right"/>
                                    </Trigger>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background"
                                                Value="{DynamicResource MenuHighlightBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource MenuDisabledTextBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style TargetType="Separator">
                    <Setter Property="Background" Value="{DynamicResource MenuSeparatorBrush}"/>
                    <Setter Property="Height" Value="1"/>
                    <Setter Property="Margin" Value="8,4"/>
                </Style>
            </Menu.Resources>
            <MenuItem Header="_File">
                <MenuItem Header="_New" InputGestureText="Ctrl+N" Click="NewFile_Click"/>
                <MenuItem Header="_New Tab" InputGestureText="Ctrl+T" Click="NewTab_Click"/>
                <MenuItem Header="_Open…" InputGestureText="Ctrl+O" Click="OpenFile_Click"/>
                <MenuItem Header="Open with _Encoding…" Click="OpenWithEncoding_Click"/>
                <MenuItem x:Name="RecentMenu" Header="Open _Recent"/>
                <Separator/>
                <MenuItem Header="_Close Tab" InputGestureText="Ctrl+W" Click="CloseTab_Click"/>
                <MenuItem Header="Close _Window" InputGestureText="Ctrl+Shift+W" Click="CloseWindow_Click"/>
                <Separator/>
                <MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="SaveFile_Click"/>
                <MenuItem Header="Save _As…" InputGestureText="Ctrl+Shift+S" Click="SaveFileAs_Click"/>
                <MenuItem Header="_Revert to Saved" Click="Revert_Click"/>
                <MenuItem Header="Document _Encoding…" Click="DocumentEncoding_Click"/>
                <Separator/>
                <MenuItem Header="_Print…" InputGestureText="Ctrl+P" Click="Print_Click"/>
                <MenuItem Header="Export as _PDF…" Click="ExportPdf_Click"/>
                <MenuItem Header="Export as _HTML…" Click="ExportHtml_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Click="Undo_Click"/>
                <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Click="Redo_Click"/>
                <Separator/>
                <MenuItem Header="Cu_t" InputGestureText="Ctrl+X" Click="Cut_Click"/>
                <MenuItem Header="_Copy" InputGestureText="Ctrl+C" Click="Copy_Click"/>
                <MenuItem Header="_Paste" InputGestureText="Ctrl+V" Click="Paste_Click"/>
                <MenuItem Header="Paste and _Match Style" InputGestureText="Ctrl+Shift+V" Click="PasteMatchStyle_Click"/>
                <MenuItem Header="Select _All" InputGestureText="Ctrl+A" Click="SelectAll_Click"/>
                <Separator/>
                <MenuItem Header="_Find…" InputGestureText="Ctrl+F" Click="Find_Click"/>
                <MenuItem Header="Find and _Replace…" InputGestureText="Ctrl+H" Click="FindReplace_Click"/>
                <MenuItem Header="Find _Next" InputGestureText="Ctrl+G" Click="FindNext_Click"/>
                <MenuItem Header="Find _Previous" InputGestureText="Ctrl+Shift+G" Click="FindPrevious_Click"/>
                <MenuItem Header="_Go to Line…" InputGestureText="Ctrl+L" Click="GoToLine_Click"/>
            </MenuItem>
            <MenuItem Header="_Format">
                <MenuItem Header="_Bold" InputGestureText="Ctrl+B" Click="Bold_Click"/>
                <MenuItem Header="_Italic" InputGestureText="Ctrl+I" Click="Italic_Click"/>
                <MenuItem Header="_Underline" InputGestureText="Ctrl+U" Click="Underline_Click"/>
                <MenuItem Header="Stri_kethrough" Click="Strikethrough_Click"/>
                <Separator/>
                <MenuItem Header="Text _Color…" Click="TextColor_Click"/>
                <MenuItem Header="_Highlight Color…" Click="HighlightColor_Click"/>
                <Separator/>
                <MenuItem Header="Align _Left" Click="AlignLeft_Click"/>
                <MenuItem Header="Align _Center" Click="AlignCenter_Click"/>
                <MenuItem Header="Align _Right" Click="AlignRight_Click"/>
                <MenuItem Header="_Justify" Click="AlignJustify_Click"/>
                <Separator/>
                <MenuItem Header="_Increase Indent" InputGestureText="Ctrl+]" Click="IncreaseIndent_Click"/>
                <MenuItem Header="_Decrease Indent" InputGestureText="Ctrl+[" Click="DecreaseIndent_Click"/>
                <Separator/>
                <MenuItem Header="Make _Rich Text" Click="MakeRichText_Click"/>
                <MenuItem Header="Make _Plain Text" Click="MakePlainText_Click"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Zoom _In" InputGestureText="Ctrl++" Click="ZoomIn_Click"/>
                <MenuItem Header="Zoom _Out" InputGestureText="Ctrl+-" Click="ZoomOut_Click"/>
                <Separator/>
                <MenuItem x:Name="WordWrapItem" Header="Word _Wrap" IsCheckable="True" Click="WordWrap_Click"/>
                <MenuItem x:Name="LineNumbersItem" Header="_Line Numbers" IsCheckable="True" Click="LineNumbers_Click"/>
                <MenuItem x:Name="InvisiblesItem" Header="Show _Invisibles" IsCheckable="True" Click="Invisibles_Click"/>
                <MenuItem x:Name="CurrentLineItem" Header="_Highlight Current Line" IsCheckable="True" Click="CurrentLine_Click"/>
                <Separator/>
                <MenuItem Header="_Syntax Highlighting">
                    <MenuItem Header="_Auto" Click="SyntaxAuto_Click"/>
                    <MenuItem Header="_Plain Text" Click="SyntaxPlain_Click"/>
                    <MenuItem Header="_C#" Click="SyntaxCSharp_Click"/>
                    <MenuItem Header="_JavaScript" Click="SyntaxJavaScript_Click"/>
                    <MenuItem Header="_Python" Click="SyntaxPython_Click"/>
                    <MenuItem Header="_HTML" Click="SyntaxHtml_Click"/>
                    <MenuItem Header="_CSS" Click="SyntaxCss_Click"/>
                    <MenuItem Header="_JSON" Click="SyntaxJson_Click"/>
                    <MenuItem Header="_Markdown" Click="SyntaxMarkdown_Click"/>
                    <MenuItem Header="_Shell" Click="SyntaxShell_Click"/>
                    <MenuItem Header="_C/C++" Click="SyntaxCpp_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Light Theme" Click="LightTheme_Click"/>
                <MenuItem Header="_Dark Theme" Click="DarkTheme_Click"/>
                <MenuItem Header="_Solarized Theme" Click="SolarizedTheme_Click"/>
                <MenuItem Header="_Sepia Theme" Click="SepiaTheme_Click"/>
                <MenuItem Header="_System Theme" Click="SystemTheme_Click"/>
                <Separator/>
                <MenuItem Header="_Preferences…" Click="Preferences_Click"/>
            </MenuItem>
            <MenuItem Header="_Window">
                <MenuItem Header="_New Tab" InputGestureText="Ctrl+T" Click="NewTab_Click"/>
                <MenuItem Header="_Close Tab" InputGestureText="Ctrl+W" Click="CloseTab_Click"/>
                <MenuItem Header="Reopen Closed _Tab" InputGestureText="Ctrl+Shift+T" Click="ReopenTab_Click"/>
                <Separator/>
                <MenuItem Header="Next _Tab" InputGestureText="Ctrl+Tab" Click="NextTab_Click"/>
                <MenuItem Header="Previous Tab" InputGestureText="Ctrl+Shift+Tab" Click="PreviousTab_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="TextPad _Help" InputGestureText="F1" Click="Help_Click"/>
                <Separator/>
                <MenuItem Header="_About TextPad" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <controls:FindBar x:Name="FindBar" DockPanel.Dock="Top"
                          SearchChanged="FindBar_SearchChanged"
                          FindNextRequested="FindBar_FindNextRequested"
                          FindPreviousRequested="FindBar_FindPreviousRequested"/>

        <StatusBar x:Name="MainStatusBar" DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="LineColStatus" Text="Ln 1, Col 1"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="CharCountStatus" Text="0 characters"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="EncodingStatus" Text="UTF-8"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="LineEndingStatus" Text="LF"/>
            </StatusBarItem>
        </StatusBar>

        <TabControl x:Name="DocumentTabs"
                    Style="{StaticResource DocumentTabControlStyle}"
                    TabStripPlacement="Top"
                    SelectionChanged="DocumentTabs_SelectionChanged">
            <TabControl.ItemContainerStyle>
                <StaticResource ResourceKey="DocumentTabItemStyle"/>
            </TabControl.ItemContainerStyle>
        </TabControl>
    </DockPanel>
</Window>