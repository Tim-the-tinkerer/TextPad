<Window x:Class="TextPad.Dialogs.PreferencesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preferences"
        Height="460" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Editor" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Theme" VerticalAlignment="Center"/>
                <ComboBox x:Name="ThemeBox" Grid.Column="1"/>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Font" VerticalAlignment="Center"/>
                <ComboBox x:Name="FontBox" Grid.Column="1"/>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Font size" VerticalAlignment="Center"/>
                <ComboBox x:Name="FontSizeBox" Grid.Column="1"/>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Tab width" VerticalAlignment="Center"/>
                <ComboBox x:Name="TabWidthBox" Grid.Column="1"/>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Line endings on save" VerticalAlignment="Center"/>
                <ComboBox x:Name="LineEndingBox" Grid.Column="1"/>
            </Grid>
            <CheckBox x:Name="WordWrapCheck" Content="Word wrap" Margin="0,4,0,4"/>
            <CheckBox x:Name="LineNumbersCheck" Content="Show line numbers" Margin="0,4,0,4"/>
            <CheckBox x:Name="CurrentLineCheck" Content="Highlight current line" Margin="0,4,0,4"/>
            <CheckBox x:Name="InvisiblesCheck" Content="Show invisible characters" Margin="0,4,0,4"/>
            <CheckBox x:Name="AutoSaveCheck" Content="Auto-save" Margin="0,4,0,4"/>
            <Grid Margin="0,4,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Auto-save interval" VerticalAlignment="Center"/>
                <ComboBox x:Name="AutoSaveIntervalBox" Grid.Column="1"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="80" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancel" Width="80" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>