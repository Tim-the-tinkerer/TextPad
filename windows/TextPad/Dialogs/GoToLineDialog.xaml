<Window x:Class="TextPad.Dialogs.GoToLineDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Go to Line"
        Height="150" Width="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText" Grid.Row="0" Margin="0,0,0,8"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBox x:Name="LineBox" Width="80" Margin="0,0,8,0"/>
            <Button Content="Go" Width="60" IsDefault="True" Click="Go_Click"/>
            <Button Content="Cancel" Width="60" Margin="6,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>