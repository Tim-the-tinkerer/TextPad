<UserControl x:Class="TextPad.Controls.FindBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed"
             Padding="6,4">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="Find:" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <TextBox x:Name="SearchBox" Grid.Column="1" MinWidth="220" KeyDown="SearchBox_KeyDown"/>
        <TextBlock x:Name="MatchCountText" Grid.Column="2" VerticalAlignment="Center" Margin="8,0"/>
        <ToggleButton x:Name="CaseToggle" Grid.Column="3" Content="Aa" Width="32" Margin="4,0" ToolTip="Match case"/>
        <Button Grid.Column="4" Content="◀" Width="32" Margin="2,0" Click="Previous_Click" ToolTip="Previous match"/>
        <Button Grid.Column="5" Content="▶" Width="32" Margin="2,0,0,0" Click="Next_Click" ToolTip="Next match"/>
    </Grid>
</UserControl>